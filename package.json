    "@types/morgan": "^1.9.4",
    "@types/node": "^20.4.2",
    "@types/node-fetch": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.44.0",
