NODE_ENV=development
PORT=3000

# Database (Postgres for production; SQLite optional for local)
DATABASE_URL=postgres://user:password@localhost:5432/cc_checker_db

# Flutterwave (fill with your sandbox or live keys)
FLW_PUBLIC_KEY=pk_TEST_xxx
FLW_SECRET_KEY=sk_TEST_xxx
FLW_SANDBOX=true

# Telegram bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_

# Admin credentials for initial setup (change in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Secrets
SESSION_SECRET=replace_this_session_secret
JWT_SECRET=replace_this_jwt_secret

# Other
SENTRY_DSN=
